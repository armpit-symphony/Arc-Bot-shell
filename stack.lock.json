{
  "lock_version": "1.0.0",
  "purpose": "Single source of truth for every live dependency pin in Arc Bot Shell. A pin recorded here is duplicated into one or more sites; scripts/check-stack-pins.py proves every site agrees with this file, and scripts/bump-pin.py moves them together. Commit hashes in docs, proof packets, and test fixtures are historical evidence, not live pins, and are deliberately absent from this lock.",
  "policies": {
    "tracking": "Expected to equal the dependency's main. Drift is reported by the scheduled currency job.",
    "frozen": "Deliberately held behind main. Requires a written reason."
  },
  "operational_paths": [
    "pyproject.toml",
    "workspace.lock.json",
    "README.md",
    ".github/workflows/*.yml",
    "scripts/*.py",
    "scripts/windows/*.ps1",
    "arc_bot_shell/lima/lima_runtime_adapter.py",
    "arc_bot_shell/service/config.py",
    "tests/test_arc_lima_rc1_consumer_pin.py",
    "tests/test_arc_windows_operator_v0_11.py"
  ],
  "dependencies": {
    "lima-runtime": {
      "repo": "armpit-symphony/LIMA-AI-OS",
      "commit": "40d6f1379284931ee46f05650e9201d6f98975d6",
      "policy": "frozen",
      "reason": "LIMA v0.1 RC1 public API freeze. tests/test_arc_lima_rc1_consumer_pin.py attests that Arc consumes exactly this commit, so moving it retires that attestation and must be a deliberate, reviewed change rather than a routine bump. Arc does not need newer LIMA: the execution-grant path consumes grants as JSON off the wire and imports nothing from lima.",
      "package": {
        "name": "lima-runtime",
        "version": "0.1.0rc1"
      },
      "sites": [
        {
          "path": "pyproject.toml",
          "pattern": "LIMA-AI-OS\\.git@(?P<commit>[0-9a-f]{40})",
          "occurrences": 1
        },
        {
          "path": "workspace.lock.json",
          "pattern": "\"ref\": \"(?P<commit>[0-9a-f]{40})\"",
          "occurrences": 1
        },
        {
          "path": "workspace.lock.json",
          "pattern": "\"name\": \"LIMA-AI-OS\"[\\s\\S]*?\"commit\": \"(?P<commit>[0-9a-f]{40})\"",
          "occurrences": 1
        },
        {
          "path": "README.md",
          "pattern": "pinned to LIMA commit\\s*`(?P<commit>[0-9a-f]{40})`",
          "occurrences": 1
        },
        {
          "path": "tests/test_arc_lima_rc1_consumer_pin.py",
          "pattern": "LIMA_COMMIT = \"(?P<commit>[0-9a-f]{40})\"",
          "occurrences": 1
        },
        {
          "path": "arc_bot_shell/lima/lima_runtime_adapter.py",
          "pattern": "LIMA_PINNED_COMMIT = \"(?P<commit>[0-9a-f]{40})\"",
          "occurrences": 1
        },
        {
          "path": "scripts/windows/common.ps1",
          "pattern": "\\$script:LimaCommit = \"(?P<commit>[0-9a-f]{40})\"",
          "occurrences": 1
        },
        {
          "path": "scripts/windows/smoke-arc-windows-operator.ps1",
          "pattern": "\\$manifest\\.lima_commit -ne \"(?P<commit>[0-9a-f]{40})\"",
          "occurrences": 1
        },
        {
          "path": "tests/test_arc_windows_operator_v0_11.py",
          "pattern": "assert \"(?P<commit>[0-9a-f]{40})\" in text",
          "occurrences": 1
        }
      ]
    },
    "guardian-suite": {
      "repo": "armpit-symphony/LIMA-Guardian-Suite",
      "commit": "69e843218c521b913edcec404dea6b7be8c64f06",
      "policy": "tracking",
      "reason": "",
      "package": null,
      "sites": [
        {
          "path": "workspace.lock.json",
          "pattern": "\"name\": \"LIMA-Guardian-Suite\"[\\s\\S]*?\"commit\": \"(?P<commit>[0-9a-f]{40})\"",
          "occurrences": 1
        },
        {
          "path": "scripts/windows/common.ps1",
          "pattern": "\\$script:GuardianCommit = \"(?P<commit>[0-9a-f]{40})\"",
          "occurrences": 1
        }
      ]
    },
    "arc-rollback-target": {
      "repo": "armpit-symphony/Arc-Bot-shell",
      "commit": "fa1e93ff18203218a863b679f3d3608aa46bd5a4",
      "policy": "frozen",
      "reason": "Arc's own v0.10 rollback target, not a dependency. It is repeated in the operator config, the Windows installer, and the installer smoke, so all four copies must agree or a rollback would restore something nobody reviewed. It moves only when the rollback baseline is deliberately re-cut.",
      "package": null,
      "sites": [
        {
          "path": "arc_bot_shell/service/config.py",
          "pattern": "ARC_V0_10_COMMIT = \"(?P<commit>[0-9a-f]{40})\"",
          "occurrences": 1
        },
        {
          "path": "scripts/windows/common.ps1",
          "pattern": "\\$script:ArcRollbackCommit = \"(?P<commit>[0-9a-f]{40})\"",
          "occurrences": 1
        },
        {
          "path": "scripts/windows/smoke-arc-windows-operator.ps1",
          "pattern": "\\$rollback\\.commit -ne \"(?P<commit>[0-9a-f]{40})\"",
          "occurrences": 1
        },
        {
          "path": "tests/test_arc_windows_operator_v0_11.py",
          "pattern": "ARC_V0_10_COMMIT == \"(?P<commit>[0-9a-f]{40})\"",
          "occurrences": 1
        }
      ]
    },
    "lima-superseded-operator-baseline": {
      "repo": "armpit-symphony/LIMA-AI-OS",
      "commit": "4e7c648349f0a5a19694ac5f0c57b5cb14dc2b17",
      "policy": "frozen",
      "reason": "Not a live pin. This is the retired v0.10/v0.11 trust baseline, kept only so an operator config persisted by an earlier install still loads and is normalised forward to the current pin. It is registered so the scan stays complete and so nobody mistakes it for something that should move. It must never be bumped; when support for that config generation is dropped, delete the entry and the frozenset member together.",
      "package": null,
      "sites": [
        {
          "path": "arc_bot_shell/lima/lima_runtime_adapter.py",
          "pattern": "LIMA_SUPERSEDED_COMMITS[\\s\\S]*?\"(?P<commit>[0-9a-f]{40})\"",
          "occurrences": 1
        }
      ]
    }
  }
}
